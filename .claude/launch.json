{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jarins-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@jarins/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "jarins-web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@jarins/web",
        "exec",
        "next",
        "start",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
