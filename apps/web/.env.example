# Leave these unset to run Jarins in local demo mode: every screen works, data
# lives in the browser, and no route is guarded.
#
# Set them and the app requires an account, guards every route through
# middleware, and stores records in Postgres behind RLS.
#
# Both are NEXT_PUBLIC and inlined at build time, so they must be present in the
# *build* environment (including CI and the Cloudflare build), not just at
# runtime. The anon key is meant to be public; authorization comes from RLS.
# The service-role key belongs only in the reminders worker, never here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Connected email is server-only. Use these names in .env.local for local
# development and `wrangler secret put <NAME>` for production. Never expose
# them with NEXT_PUBLIC_ or commit their values.
# One AES-256 key encrypts provider refresh tokens and app passwords. The old
# EMAIL_TOKEN_ENCRYPTION_KEY name remains a compatibility fallback.
INTEGRATION_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
EMAIL_OAUTH_REDIRECT_ORIGIN=http://localhost:3000
GOOGLE_EMAIL_CLIENT_ID=google-oauth-client-id
GOOGLE_EMAIL_CLIENT_SECRET=google-oauth-client-secret
MICROSOFT_EMAIL_CLIENT_ID=microsoft-application-client-id
MICROSOFT_EMAIL_CLIENT_SECRET=microsoft-application-client-secret

# Connected calendars. Calendar-specific OAuth credentials are recommended;
# when omitted, Jarins falls back to the matching email OAuth client above.
# Register /api/calendar/oauth/{google|microsoft}/callback for localhost and
# https://jarins.com with each provider.
CALENDAR_OAUTH_REDIRECT_ORIGIN=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=google-oauth-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=microsoft-application-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=microsoft-application-client-secret

# VAULT external storage. Storage-specific OAuth clients are recommended;
# Google and Microsoft fall back to their matching calendar/email client when
# omitted. Register /api/storage/oauth/{google-drive|onedrive|dropbox}/callback
# for localhost and https://jarins.com. Dropbox apps must use Full Dropbox and
# enable account_info.read, files.metadata.read, files.content.read, plus the
# metadata/content write scopes when Manage access is offered.
STORAGE_OAUTH_REDIRECT_ORIGIN=http://localhost:3000
GOOGLE_STORAGE_CLIENT_ID=google-oauth-client-id
GOOGLE_STORAGE_CLIENT_SECRET=google-oauth-client-secret
MICROSOFT_STORAGE_CLIENT_ID=microsoft-application-client-id
MICROSOFT_STORAGE_CLIENT_SECRET=microsoft-application-client-secret
DROPBOX_STORAGE_CLIENT_ID=dropbox-app-key
DROPBOX_STORAGE_CLIENT_SECRET=dropbox-app-secret
