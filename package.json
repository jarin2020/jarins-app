{
  "name": "jarins",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:cloudflare": "pnpm --filter @jarins/web exec opennextjs-cloudflare build",
    "deploy:cloudflare": "pnpm --filter @jarins/web run deploy && pnpm deploy:cloudflare:redirect",
    "deploy:cloudflare:redirect": "pnpm --filter @jarins/web exec wrangler deploy --config ../../apps/www-redirect/wrangler.jsonc",
    "cf-typegen": "pnpm --filter @jarins/web cf-typegen",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rls": "./supabase/tests/run.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
